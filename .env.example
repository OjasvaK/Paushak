# PAUSHAAK environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# Each section is introduced by the stage that first needs it (see steps.md).

# --- Stage 2: Supabase (supabase.com -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stage 5: Voice onboarding ---
BHASHINI_API_KEY=
GROQ_API_KEY=

# --- Stage 6: Async image enhancement ---
UPSTASH_QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
HF_SPACE_URL=
HF_SPACE_TOKEN=

# --- Stage 7: Embeddings, search, chatbot ---
GEMINI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Stage 10: Email ---
RESEND_API_KEY=
